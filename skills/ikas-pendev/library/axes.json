{
  "version": 1,
  "about": "Differentiation axes (references/12-library.md §6–§7). Each axis has fields; each field has allowed values and the generic default ('median') that makes themes look alike. Two themes differ on an axis when any of its fields differs. Ranges and thresholds are uncalibrated proposals.",
  "gate": {
    "structural_min_diff": 4,
    "token_min_diff": 5,
    "token_must_differ": [
      "B7",
      "B12"
    ],
    "generic_warn_at": 3,
    "layout_min_distance": 0.5,
    "shot_min_distance": 0.35
  },
  "forbidden_fonts": [
    "Inter",
    "Roboto",
    "Open Sans",
    "Lato",
    "Arial",
    "Helvetica",
    "system-ui"
  ],
