{
  "version": 1,
  "about": "Structure inventory for ikas-ecommerce.lib.pen (references/12-library.md). Parts, states and port marks only: no value, no layout. Layer and state names follow 02-contract.md §9 and 06-page-coverage.md §3; this file adds the evidence-backed must-haves. Part flags: req = always present and enabled; opt = present but enabled:false, switched on by the theme. ikas: yes = storefront API supports it, no = not in ikas (06 §3b), check = not verified yet.",
  "basis": {
    "baymard": "usability research: the share of large sites that get it wrong",
    "platform": "every major theme platform has it; no usability evidence",
    "contract": "already required by this skill (02 §9, 06 §3)",
    "w3c": "accessibility requirement"
  },
  "kinds": {
    "sub": "reusable root P/Sub/<Name>; becomes src/sub-components/<Name>",
    "block": "frame copied into a section (ProductDetail, ProductList …); never a Sub",
    "section": "shell section P/Section/<Name>@desktop|@mobile",
    "overlay": "P/Overlay/<Name>@desktop|@mobile — <state>"
  },
  "states": {
    "varsayılan": "default",
    "hover": "pointer over",
    "odak": "focus-visible ring; every interactive part (baymard: 48% drop it)",
    "basılı": "active / pressed",
    "pasif": "disabled",
    "seçili": "selected",
    "mevcut": "current scope or page",
    "stok yok": "sold out / unavailable value",
    "indirimli": "sale price with struck compare price",
    "sepette": "already in the cart",
    "yükleniyor": "loading or skeleton",
    "güncelleniyor": "a change is being saved",
    "eklendi": "success after an add",
    "boş": "no items",
    "dolu": "has items",
    "hata": "error with a specific message",
    "sonuç yok": "no results",
    "açık": "expanded / open",
    "kapalı": "collapsed / closed",
    "alt sınır": "at minimum",
    "üst sınır": "at maximum",
    "yapışkan": "pinned while scrolling",
    "şeffaf": "transparent over media",
    "misafir": "signed out",
    "üye": "signed in",
    "medya yok": "image placeholder",
    "duraklatıldı": "moving content paused"
  },
  "components": [
    {
      "name": "Button",
      "layer": "primitive",
      "kind": "sub",
      "basis": [
        "contract",
        "platform"
      ],
      "parts": [
        {
          "layer": "btn-label",
          "req": true
        },
        {
          "layer": "btn-icon",
          "opt": true,
          "ikas": "yes"
        },
        {
          "layer": "btn-spinner",
          "req": true,
          "note": "shown in yükleniyor"
        }
      ],
      "states": [
        "varsayılan",
        "hover",
        "odak",
        "basılı",
        "pasif",
        "yükleniyor",
        "eklendi",
        "stok yok"
      ],
      "axes": [
        "importance: primary / secondary / tertiary / link",
        "size: sm / md / lg"
      ]
    },
    {
      "name": "ArrowLink",
      "layer": "primitive",
      "kind": "sub",
      "basis": [
        "contract"
      ],
      "parts": [
        {
          "layer": "link-text",
          "req": true
        },
        {
          "layer": "link-icon",
          "opt": true,
          "ikas": "yes"
        },
        {
          "layer": "link-line",
          "opt": true,
          "ikas": "yes"
        }
      ],
      "states": [
        "varsayılan",
        "hover",
        "odak",
        "mevcut"
      ],
      "must": [
        {
          "rule": "link text names the destination, never a bare 'Shop now'",
          "basis": "baymard",
          "figure": "66%"
        }
      ]
    },
    {
      "name": "IconButton",
      "layer": "primitive",
      "kind": "sub",
      "basis": [
        "contract"
      ],
      "parts": [
        {
          "layer": "icon",
          "req": true
        }
      ],
      "states": [
        "varsayılan",
        "hover",
        "odak",
        "pasif"
      ],
      "must": [
        {
          "rule": "accessible name as a TEXT prop (aria-label)",
          "basis": "w3c"
        }
      ]
    },
    {
      "name": "FormField",
      "layer": "primitive",
      "kind": "sub",
      "basis": [
        "contract",
        "baymard"
      ],
      "parts": [
        {
          "layer": "field-label",
          "req": true
        },
        {
          "layer": "field-input",
          "req": true
        },
        {
          "layer": "field-required",
          "req": true,
          "note": "required or optional mark"
        },
        {
          "layer": "field-help",
          "opt": true,
          "ikas": "yes"
        },
        {
          "layer": "field-error",
          "req": true,
          "note": "$color-danger, hidden outside hata"
        }
      ],
      "states": [
        "boş",
        "dolu",
        "odak",
        "hata",
        "pasif"
      ],
      "axes": [
        "control: input / textarea / select"
      ],
      "must": [
        {
          "rule": "error text names the field's own problem (adaptive), not a generic 'invalid'",
          "basis": "baymard",
          "figure": "94%"
        },
        {
          "rule": "visible label on every field",
          "basis": "baymard",
          "figure": "37%"
        }
      ]
    },
    {
      "name": "Checkbox",
